<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Memory.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    <style name="Text.Memory.Title" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="Text.Memory.Section" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Memory.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Widget.Memory.Secondary" parent="Widget.Memory.Primary">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/accent</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Memory.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Memory.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>
</resources>
