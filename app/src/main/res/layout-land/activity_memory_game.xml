<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/app_background" android:paddingHorizontal="20dp" android:paddingVertical="8dp">
    <androidx.core.widget.NestedScrollView
        android:layout_width="216dp" android:layout_height="match_parent"
        android:layout_marginEnd="16dp" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button" android:src="@drawable/ic_back" android:contentDescription="@string/btn_back" />
                <TextView style="@style/Text.Memory.Section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/title_memory_game" />
                <ImageButton android:id="@+id/btn_rules" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_info" android:contentDescription="@string/game_rules_button" />
            </LinearLayout>
            <TextView style="@style/Text.Memory.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textSize="16sp" android:text="@string/game_subtitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/game_rule" android:textColor="@color/ink_secondary" android:textSize="10sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="horizontal" android:background="@drawable/bg_surface" android:padding="12dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.Memory.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_score" />
                    <TextView android:id="@+id/tv_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/accent" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                    <TextView style="@style/Text.Memory.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_pairs" />
                    <TextView android:id="@+id/tv_pairs" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/ink" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/tv_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="36dp" android:layout_marginTop="8dp" android:padding="8dp" android:background="@drawable/bg_feedback"
                android:textColor="@color/accent_dark" android:textSize="10sp" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/tv_attempts" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginVertical="6dp" android:gravity="center" android:textColor="@color/ink_secondary" android:textSize="10sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_exit" style="@style/Widget.Memory.Secondary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/btn_exit"
                    android:textSize="11sp" android:paddingHorizontal="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_restart" style="@style/Widget.Memory.Primary"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp"
                    android:text="@string/btn_restart" android:textSize="11sp" android:paddingHorizontal="4dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid_cards"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:overScrollMode="never" android:contentDescription="@string/board_label" />
</LinearLayout>
