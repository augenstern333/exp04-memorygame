<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="true"
    android:paddingHorizontal="24dp"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                style="@style/Text.Memory.Label" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_cards"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Memory.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_eyebrow"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/home_title"
                    android:textColor="@color/ink"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:letterSpacing="-0.04" />
            </LinearLayout>
            <com.example.liushimin2024110523.exp04.MemoryArtworkView
                android:layout_width="112dp"
                android:layout_height="150dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_score"
            android:padding="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_high_score"
                    android:textColor="#DEE8FF"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:id="@+id/tv_high_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_high_score"
                        android:textColor="@color/white"
                        android:textSize="44sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/score_unit"
                        android:textColor="#DEE8FF"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/best_caption"
                    android:textColor="#DEE8FF"
                    android:textSize="11sp" />
            </LinearLayout>
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_cup"
                app:tint="#C1D4FF"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">
            <TextView
                style="@style/Text.Memory.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_player_info" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_info"
                style="@style/Widget.Memory.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/btn_edit_info"
                app:icon="@drawable/ic_edit"
                app:iconSize="15dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="15dp">
                <TextView
                    android:id="@+id/tv_monogram"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ink_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp">
                <TextView
                    style="@style/Text.Memory.Label"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_gender" />
                <TextView
                    android:id="@+id/tv_gender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp">
                <TextView
                    style="@style/Text.Memory.Label"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_student_id" />
                <TextView
                    android:id="@+id/tv_student_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp">
                <TextView
                    style="@style/Text.Memory.Label"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_phone" />
                <TextView
                    android:id="@+id/tv_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp">
                <TextView
                    style="@style/Text.Memory.Label"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email" />
                <TextView
                    android:id="@+id/tv_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp">
                <TextView
                    style="@style/Text.Memory.Label"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_hobby" />
                <TextView
                    android:id="@+id/tv_hobby"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_play_game"
            style="@style/Widget.Memory.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_play_game"
            app:icon="@drawable/ic_arrow"
            app:iconGravity="textEnd"
            app:iconPadding="14dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:text="@string/home_footer"
            android:textColor="@color/ink_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
